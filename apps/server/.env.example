# Application
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=mongodb://localhost:27017/operatio

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d


# Email (Sendlib)
SEND_LIB_API_KEY=your-sendlib-api-key
SEND_LIB_FROM="Operatio <yourproduct@gmail.com>"

# Custom Domains: set provider to `cloudflare` or `vercel`
CUSTOM_DOMAIN_PROVIDER=cloudflare

# Cloudflare for SaaS (required when CUSTOM_DOMAIN_PROVIDER=cloudflare)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_FALLBACK_ORIGIN=your-app.vercel.app

# Vercel project domains (required when CUSTOM_DOMAIN_PROVIDER=vercel)
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
# VERCEL_TEAM_ID=your-vercel-team-id
